<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f7f4fc" />
  <meta name="referrer" content="no-referrer" />
  <title><%= {login:'Entrar',register:'Criar conta',forgot:'Recuperar senha',reset:'Nova senha',verify:'Confirmar e-mail'}[mode] %> — Pattern</title>
  <script src="<%= assetUrl('/static/js/theme.js') %>"></script>
  <link rel="stylesheet" href="<%= assetUrl('/static/css/style.css') %>" />
  <link rel="stylesheet" href="<%= assetUrl('/static/css/theme.css') %>" />
  <script defer src="<%= assetUrl('/static/js/auth.js') %>"></script>
</head>
<body class="auth-body">
  <label class="auth-theme-choice theme-choice"><span class="theme-choice-icon" aria-hidden="true">◐</span><select class="theme-select" data-theme-select aria-label="Tema da aplicação"><option value="light">☀ Claro</option><option value="dark">☾ Escuro</option><option value="system">◉ Automático</option></select></label>
  <div class="auth-decor decor-one"></div><div class="auth-decor decor-two"></div>
  <main class="auth-wrap">
    <a class="auth-logo" href="/">✳ <span>pattern<span class="logo-dot">.</span></span></a>
    <section class="auth-card">
      <p class="eyebrow">SEU ESPAÇO DE ORGANIZAÇÃO</p>
      <h1><%= {login:'Que bom ter você aqui.',register:'Comece no seu ritmo.',forgot:'Vamos recuperar seu acesso.',reset:'Escolha sua nova senha.',verify:'Confirme seu e-mail.'}[mode] %></h1>
      <p class="muted"><%= {login:'Um dia de cada vez, com um pouco mais de clareza.',register:'Planeje seus dias, acompanhe hábitos e descubra seus próprios padrões.',forgot:'Se o endereço estiver cadastrado, enviaremos um link de recuperação.',reset:'Use uma senha exclusiva com pelo menos 10 caracteres.',verify:'Confirme seu endereço para manter sua conta atualizada.'}[mode] %></p>
      <% if (mode !== 'verify') { %>
      <form id="authForm" data-mode="<%= mode %>" class="form-stack">
        <% if (mode === 'register') { %><label>Seu nome<input name="name" autocomplete="name" maxlength="80" minlength="2" required placeholder="Como podemos chamar você?" /></label><% } %>
        <% if (mode === 'login' || mode === 'register' || mode === 'forgot') { %><label>E-mail<input name="email" type="email" autocomplete="email" required placeholder="voce@email.com" /></label><% } %>
        <% if (mode === 'login' || mode === 'register') { %><label>Senha<input name="password" type="password" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" minlength="<%= mode === 'register' ? 10 : 1 %>" required placeholder="<%= mode === 'register' ? 'No mínimo 10 caracteres' : 'Sua senha' %>" /></label><% } %>
        <% if (mode === 'reset') { %><label>Nova senha<input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="72" required placeholder="No mínimo 10 caracteres" /></label><input type="hidden" name="token" id="authToken"/><% } %>
        <p class="error-message" id="formError" role="alert" hidden></p>
        <p class="account-feedback" id="formSuccess" role="status" hidden></p>
        <button class="btn btn-primary full" id="submitButton" type="submit"><%= {login:'Entrar no Pattern',register:'Criar minha conta',forgot:'Enviar link de recuperação',reset:'Salvar nova senha'}[mode] %> <span>↗</span></button>
      </form>
      <% } else { %><p class="muted" id="verifyStatus" role="status">Confirmando seu endereço...</p><button type="button" class="btn btn-primary full" id="verifyButton" hidden>Tentar novamente</button><% } %>
      <p class="auth-bottom"><% if (mode === 'login') { %><a href="/forgot-password">Esqueci minha senha</a> · <a href="/register">Criar conta</a><% } else { %><a href="/login">Voltar para entrar</a><% } %></p>
    </section>
    <p class="fineprint">A organização deve caber na sua vida — não o contrário.</p>
  </main>
</body>
</html>
