<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f7f4fc" />
  <title><%= mode === 'register' ? 'Criar conta' : 'Entrar' %> — Pattern</title>
  <script src="<%= assetUrl('/static/js/theme.js') %>"></script>
  <link rel="stylesheet" href="<%= assetUrl('/static/css/style.css') %>" />
  <link rel="stylesheet" href="<%= assetUrl('/static/css/theme.css') %>" />
  <script defer src="<%= assetUrl("/static/js/auth.js") %>"></script>
</head>
<body class="auth-body">
  <label class="auth-theme-choice theme-choice"><span class="theme-choice-icon" aria-hidden="true">◐</span><select class="theme-select" data-theme-select aria-label="Tema da aplicação"><option value="light">☀ Claro</option><option value="dark">☾ Escuro</option><option value="system">◉ Automático</option></select></label>
  <div class="auth-decor decor-one"></div><div class="auth-decor decor-two"></div>
  <main class="auth-wrap">
    <a class="auth-logo" href="/">✳ <span>pattern<span class="logo-dot">.</span></span></a>
    <section class="auth-card">
      <p class="eyebrow">SEU ESPAÇO DE ORGANIZAÇÃO</p>
      <h1><%= mode === 'register' ? 'Comece no seu ritmo.' : 'Que bom ter você aqui.' %></h1>
      <p class="muted"><%= mode === 'register' ? 'Planeje seus dias, acompanhe hábitos e descubra seus próprios padrões.' : 'Um dia de cada vez, com um pouco mais de clareza.' %></p>
      <form id="authForm" data-mode="<%= mode %>" class="form-stack">
        <% if (mode === 'register') { %>
          <label>Seu nome <input name="name" autocomplete="name" maxlength="80" minlength="2" required placeholder="Como podemos chamar você?" /></label>
        <% } %>
        <label>E-mail <input name="email" type="email" autocomplete="email" required placeholder="voce@email.com" /></label>
        <label>Senha <input name="password" type="password" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" minlength="8" required placeholder="No mínimo 8 caracteres" /></label>
        <p class="error-message" id="formError" role="alert" hidden></p>
        <button class="btn btn-primary full" id="submitButton" type="submit"><%= mode === 'register' ? 'Criar minha conta' : 'Entrar no Pattern' %> <span>↗</span></button>
      </form>
      <p class="auth-bottom"><%= mode === 'register' ? 'Já tem uma conta?' : 'Ainda não tem uma conta?' %> <a href="<%= mode === 'register' ? '/login' : '/register' %>"><%= mode === 'register' ? 'Entrar' : 'Criar conta' %></a></p>
    </section>
    <p class="fineprint">A organização deve caber na sua vida — não o contrário.</p>
  </main>
</body>
</html>
