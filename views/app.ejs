<!DOCTYPE html>
<html lang="pt-BR" data-theme-preference="<%= themePreference %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f7f4fc" />
  <title><%= {app:'Hoje',tasks:'Tarefas',calendar:'Calendário',habits:'Hábitos',insights:'Insights',focus:'Foco',goals:'Objetivos',review:'Retrospectiva',intelligence:'Inteligência',settings:'Minha conta'}[page] %> — Pattern</title>
  <script src="<%= assetUrl('/static/js/theme.js') %>"></script>
  <link rel="stylesheet" href="<%= assetUrl('/static/css/style.css') %>" />
  <link rel="stylesheet" href="<%= assetUrl('/static/css/theme.css') %>" />
  <script defer src="<%= assetUrl('/static/js/habit-utils.js') %>"></script>
  <script defer src="<%= assetUrl('/static/js/app.js') %>"></script>
  <% if (page === "insights") { %><script defer src="<%= assetUrl('/static/js/analytics.js') %>"></script><% } %>
  <% if (page === "focus") { %><script defer src="<%= assetUrl('/static/js/focus-core.js') %>"></script><script defer src="<%= assetUrl('/static/js/focus.js') %>"></script><% } %>
  <% if (page === "goals") { %><script defer src="<%= assetUrl('/static/js/goals.js') %>"></script><% } %>
  <% if (page === "review") { %><script defer src="<%= assetUrl('/static/js/review.js') %>"></script><% } %>
  <% if (page === "intelligence") { %><script defer src="<%= assetUrl('/static/js/intelligence.js') %>"></script><% } %>
  <% if (page === "settings") { %><script defer src="<%= assetUrl('/static/js/account.js') %>"></script><% } %>
</head>
<body data-page="<%= page %>">
  <div class="shell">
    <aside class="sidebar" aria-label="Menu principal">
      <a href="/app" class="logo"><span class="logo-mark">✳</span> pattern<span class="logo-dot">.</span></a>
      <div class="side-section-label">MENU</div>
      <nav class="nav-list">
        <a href="/app" class="nav-link <%= page === 'app' ? 'active' : '' %>"><span class="nav-icon">⌂</span> Hoje</a>
        <a href="/tasks" class="nav-link <%= page === 'tasks' ? 'active' : '' %>"><span class="nav-icon">☑</span> Tarefas</a>
        <a href="/focus" class="nav-link <%= page === 'focus' ? 'active' : '' %>"><span class="nav-icon">◉</span> Foco</a>
        <a href="/calendar" class="nav-link <%= page === 'calendar' ? 'active' : '' %>"><span class="nav-icon">▦</span> Calendário</a>
        <a href="/habits" class="nav-link <%= page === 'habits' ? 'active' : '' %>"><span class="nav-icon">◷</span> Hábitos</a>
        <a href="/goals" class="nav-link <%= page === 'goals' ? 'active' : '' %>"><span class="nav-icon">◎</span> Objetivos</a>
        <a href="/intelligence" class="nav-link <%= page === 'intelligence' ? 'active' : '' %>"><span class="nav-icon">✧</span> Inteligência</a>
        <a href="/review" class="nav-link <%= page === 'review' ? 'active' : '' %>"><span class="nav-icon">◫</span> Retrospectiva</a>
        <a href="/insights" class="nav-link <%= page === 'insights' ? 'active' : '' %>"><span class="nav-icon">◫</span> Insights</a>
      </nav>
      <div class="sidebar-bottom">
        <div class="gentle-note"><span>✦</span><p>Pequenos passos também são progresso.</p></div>
        <div class="profile <%= page === 'settings' ? 'profile-selected' : '' %>">
          <a class="profile-link" href="/settings" aria-label="Abrir Minha conta">
            <span class="avatar"><%= name.charAt(0).toUpperCase() %></span>
            <span class="profile-name"><strong><%= name %></strong><span>Minha conta →</span></span>
          </a>
          <button class="logout" id="logoutBtn" type="button" title="Sair" aria-label="Sair">↗</button>
        </div>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar"><div class="breadcrumb">Meu espaço <span>/</span> <strong><%= {app:'Hoje',tasks:'Tarefas',calendar:'Calendário',habits:'Hábitos',insights:'Insights',focus:'Foco',goals:'Objetivos',review:'Retrospectiva',intelligence:'Inteligência',settings:'Minha conta'}[page] %></strong></div><div class="topbar-tools"><label class="theme-choice"><span class="theme-choice-icon" aria-hidden="true">◐</span><span class="theme-choice-text">Tema</span><select class="theme-select" data-theme-select aria-label="Tema da aplicação"><option value="light">☀ Claro</option><option value="dark">☾ Escuro</option><option value="system">◉ Automático</option></select></label><div class="topbar-date" id="topbarDate"></div></div></header>
      <% if (page === 'app') { %>
        <section class="hero-banner">
          <div><span class="hero-kicker">✧ UM NOVO DIA, NO SEU RITMO</span><h1>Olá, <%= name.split(' ')[0] %> <span class="wave">✳</span></h1><p id="heroSubtitle">Vamos organizar o que importa hoje, sem pressa.</p><div class="hero-actions"><button class="btn btn-white" id="quickTask">+ Tarefa de hoje</button><a class="btn hero-outline" href="/calendar">Ver calendário →</a></div></div>
          <div class="hero-art" aria-hidden="true"><span class="blob-main"></span><span class="orbit one">✳</span><span class="orbit two">✦</span><span class="orbit three">◌</span></div>
        </section>
        <section class="stats-grid" id="dashboardStats" aria-label="Resumo do dia"><div class="stat-card skeleton">Carregando resumo...</div></section>
        <div class="dashboard-focus">
          <section class="panel progress-panel"><div class="panel-header"><div><p class="eyebrow">SEU RITMO DE HOJE</p><h2>Um passo de cada vez</h2></div><span class="progress-sparkle" aria-hidden="true">✳</span></div><div id="homeProgress"><p class="muted">Carregando progresso...</p></div></section>
          <section class="panel agenda-panel"><div class="panel-header"><div><p class="eyebrow">NÃO PERCA DE VISTA</p><h2>Próximos compromissos</h2></div><a class="subtle-link" href="/calendar">Calendário →</a></div><div id="homeEvents" class="agenda-items"><p class="muted">Carregando agenda...</p></div></section>
        </div>
        <section class="panel dashboard-focus-shortcut">
          <div class="focus-shortcut-icon">◉</div>
          <div class="focus-shortcut-text"><p class="eyebrow">SEU TEMPO TEM VALOR</p><h2>Um momento de foco</h2><p id="homeFocusSummary" class="muted small">Carregando seu tempo de foco...</p></div>
          <a class="btn btn-primary" href="/focus">Abrir modo foco →</a>
        </section>
        <div class="two-columns">
          <section class="panel"><div class="panel-header"><div><p class="eyebrow">NA ORDEM CERTA</p><h2>Próximas tarefas</h2></div><a class="subtle-link" href="/tasks">Ver todas →</a></div><div id="homeTasks" class="items-list"><p class="muted">Carregando...</p></div></section>
          <section class="panel"><div class="panel-header"><div><p class="eyebrow">CONSISTÊNCIA, NÃO PERFEIÇÃO</p><h2>Hábitos de hoje</h2></div><a class="subtle-link" href="/habits">Ver hábitos →</a></div><div id="homeHabits" class="items-list"><p class="muted">Carregando...</p></div></section>
        </div>
        <section class="panel week-panel"><div class="panel-header"><div><p class="eyebrow">UMA SEMANA MAIS LEVE</p><h2>Seus próximos 7 dias</h2></div><a class="subtle-link" href="/calendar">Abrir calendário →</a></div><div id="weekStrip" class="week-strip" aria-label="Resumo dos próximos sete dias"><p class="muted">Carregando semana...</p></div><p class="week-legend">◉ Tarefas com prazo pendentes ou compromissos agendados</p></section>
        <section class="quote-bar"><span>✦</span> Você não precisa fazer tudo hoje. Só precisa decidir o que é importante.</section>
      <% } else if (page === 'tasks') { %>
        <section class="page-heading"><div><p class="eyebrow">UMA COISA DE CADA VEZ</p><h1>Minhas tarefas <span class="heading-sparkle">✳</span></h1><p class="muted">Um lugar para tudo o que você quer realizar.</p></div><button class="btn btn-primary" id="newTask">+ Nova tarefa</button></section>
        <section class="panel"><div class="filter-row"><div class="tabs" role="group" aria-label="Filtrar tarefas"><button class="tab active" data-filter="all">Todas</button><button class="tab" data-filter="pending">Pendentes</button><button class="tab" data-filter="done">Concluídas</button></div><span class="filter-count" id="tasksCount"></span></div><div class="items-list" id="taskList"><p class="muted">Carregando tarefas...</p></div></section>
      <% } else if (page === 'focus') { %>
        <section class="page-heading focus-heading"><div><p class="eyebrow">UM MOMENTO PARA O QUE IMPORTA</p><h1>Modo Foco <span class="heading-sparkle">✳</span></h1><p class="muted">Escolha uma tarefa, encontre seu ritmo e acompanhe o tempo dedicado.</p></div></section>
        <div class="focus-layout">
          <section class="panel focus-session-panel" aria-label="Cronômetro de foco">
            <div class="focus-modes" role="group" aria-label="Modo da sessão"><button class="focus-mode is-active" type="button" data-focus-mode="pomodoro" aria-pressed="true">◷ Pomodoro</button><button class="focus-mode" type="button" data-focus-mode="free" aria-pressed="false">⏱ Cronômetro livre</button></div>
            <div class="focus-setup"><label>Vincular a uma tarefa (opcional)<select id="focusTask"><option value="">Sem tarefa vinculada</option></select></label><div id="focusDurationWrap"><label for="focusDuration">Duração do foco (minutos)</label><div class="focus-duration-line"><input type="number" id="focusDuration" value="25" min="5" max="180" step="1" /><div class="focus-presets" role="group" aria-label="Tempos sugeridos"><button type="button" data-focus-minutes="15">15</button><button type="button" class="is-active" data-focus-minutes="25">25</button><button type="button" data-focus-minutes="50">50</button></div></div></div></div>
            <div class="focus-dial-area"><div class="focus-dial" id="focusDial"><div class="focus-dial-inner"><span class="focus-dial-caption" id="focusTimerLabel">TEMPO PARA FOCAR</span><strong class="focus-time" id="focusTimer" aria-live="off">25:00</strong><span class="focus-dial-status" id="focusStatus">Pronta para começar</span></div></div></div>
            <p class="focus-current-task" id="focusCurrentTask">Escolha uma tarefa ou comece livremente.</p>
            <p class="focus-error error-message" id="focusError" role="alert" hidden></p>
            <div class="focus-actions"><button type="button" class="btn btn-primary" id="focusStart">▶ Iniciar foco</button><button type="button" class="btn btn-soft" id="focusPause" hidden>Ⅱ Pausar</button><button type="button" class="btn btn-primary" id="focusResume" hidden>▶ Retomar</button><button type="button" class="btn btn-danger-outline" id="focusFinish" hidden>□ Encerrar e salvar</button></div>
            <p class="muted small focus-footnote">O tempo de foco não inclui as pausas. Sessões concluídas ficam registradas no histórico.</p>
            <div class="focus-break-panel" id="focusBreakPanel" hidden><p class="eyebrow">DESCANSE UM POUCO</p><h3>Intervalo entre sessões</h3><strong id="focusBreakTime">05:00</strong><div class="focus-actions"><button type="button" class="btn btn-soft" id="focusBreakStart">Começar intervalo</button><button type="button" class="btn btn-soft" id="focusBreakSkip">Ignorar intervalo</button></div></div>
          </section>
          <section class="focus-side-column"><div class="panel focus-week-panel"><div class="panel-header"><div><p class="eyebrow">SEU RITMO</p><h2>Tempo de foco</h2></div><select id="focusRange" aria-label="Período do histórico"><option value="7">7 dias</option><option value="14">14 dias</option><option value="30">30 dias</option></select></div><div class="focus-stats"><div><strong id="focusTotal">0 min</strong><span>Tempo registrado</span></div><div><strong id="focusSessions">0</strong><span>Sessões</span></div><div><strong id="focusDays">0</strong><span>Dias ativos</span></div></div><div class="focus-bars" id="focusBars" aria-label="Foco por dia"></div></div><div class="panel focus-history-panel"><div class="panel-header"><div><p class="eyebrow">UM DIA DE CADA VEZ</p><h2>Últimas sessões</h2></div></div><div id="focusHistory" class="focus-history-list"><p class="muted small">Carregando histórico...</p></div></div></section>
        </div>
      <% } else if (page === 'calendar') { %>
        <section class="page-heading calendar-heading">
          <div><p class="eyebrow">UM LUGAR PARA SEUS PLANOS</p><h1>Meu calendário <span class="heading-sparkle">✳</span></h1><p class="muted">Planeje seu tempo com leveza, no seu ritmo.</p></div>
          <button class="btn btn-primary" id="newEvent" type="button">+ Novo compromisso</button>
        </section>
        <section class="panel calendar-panel" aria-label="Calendário interativo">
          <div class="calendar-controls">
            <div class="calendar-title-group"><p class="eyebrow">SEUS PRÓXIMOS PASSOS</p><h2 id="calendarTitle" aria-live="polite">Carregando calendário...</h2></div>
            <div class="calendar-toolbar">
              <div class="calendar-switch" role="group" aria-label="Visualização do calendário">
                <button type="button" class="calendar-switch-btn active" data-calendar-view="month" aria-pressed="true">Mês</button>
                <button type="button" class="calendar-switch-btn" data-calendar-view="week" aria-pressed="false">Semana</button><button type="button" class="calendar-switch-btn" data-calendar-view="day" aria-pressed="false">Dia</button>
              </div>
              <div class="calendar-actions">
                <button class="icon-button" id="prevPeriod" type="button" aria-label="Período anterior">←</button>
                <button class="btn btn-soft" id="currentPeriod" type="button">Hoje</button>
                <button class="icon-button" id="nextPeriod" type="button" aria-label="Próximo período">→</button>
              </div>
            </div>
          </div>
          <div class="calendar-categories-row"><div class="calendar-legend" id="calendarLegend" aria-label="Blocos de compromissos"></div><button type="button" class="btn btn-soft" id="manageCategories">✎ Meus blocos</button></div>
          <p class="calendar-help">Veja seus planos por mês, semana ou dia. Arraste compromissos para mudar o dia ou horário; no celular, toque para editar. Sobreposições são sinalizadas antes de salvar.</p>
          <div class="calendar-scroll" tabindex="0" aria-label="Grade do calendário com rolagem horizontal em telas pequenas">
            <div class="calendar-weekdays" id="calendarWeekdays" aria-hidden="true"><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span></div>
            <div id="calendarGrid" class="calendar-grid calendar-month" aria-live="polite"><p class="muted">Carregando agenda...</p></div><div id="calendarDayView" class="day-view" hidden></div>
          </div>
          <p class="calendar-feedback" id="calendarFeedback" role="status" aria-live="polite"></p><div id="calendarConflictSummary" class="calendar-conflict-summary" hidden></div>
        </section>
        <section class="panel calendar-backlog">
          <div class="panel-header"><div><p class="eyebrow">AINDA SEM DATA</p><h2>Tarefas para planejar</h2></div><span class="muted small" id="unscheduledCount"></span></div>
          <p class="muted small calendar-backlog-help">Arraste uma tarefa para um dia do calendário ou clique nela para definir seu prazo.</p>
          <div id="unscheduledTasks" class="unscheduled-tasks"></div>
        </section>
      <% } else if (page === 'habits') { %>
        <section class="page-heading"><div><p class="eyebrow">PEQUENOS PASSOS, GRANDES MUDANÇAS</p><h1>Meus hábitos <span class="heading-sparkle">✳</span></h1><p class="muted">Faça espaço para aquilo que importa, no seu ritmo.</p></div><button class="btn btn-primary" type="button" id="newHabit">+ Novo hábito</button></section>
        <section class="habit-overview" id="habitOverview" aria-label="Resumo dos hábitos"><p class="muted">Carregando seus hábitos...</p></section>
        <section class="panel routines-panel"><div class="panel-header"><div><p class="eyebrow">SEUS RITUAIS</p><h2>Minhas rotinas</h2><p class="muted small">Agrupe hábitos para organizar suas manhãs, noites e momentos livres.</p></div><button class="btn btn-soft" id="newRoutine" type="button">+ Criar rotina</button></div><div id="routineList" class="routine-list"></div></section>
        <section class="panel habits-panel"><div class="panel-header"><div><p class="eyebrow">CONSTÂNCIA, NÃO PERFEIÇÃO</p><h2>Acompanhamento semanal</h2><p class="muted small">Clique nos dias planejados para registrar suas realizações.</p></div></div><div id="habitList" class="habit-cards"><p class="muted">Carregando hábitos...</p></div></section>
      <% } else if (page === 'goals') { %>
        <section class="page-heading goals-heading">
          <div><p class="eyebrow">UM OBJETIVO DE CADA VEZ</p><h1>Meus objetivos <span class="heading-sparkle">✳</span></h1><p class="muted">Transforme seus planos em etapas concretas.</p></div>
          <button class="btn btn-primary" type="button" id="goalNew">+ Novo objetivo</button>
        </section>
        <section class="goal-overview" id="goalOverview" aria-label="Resumo dos objetivos"><p class="muted">Carregando...</p></section>
        <section class="panel goals-main-panel">
          <div class="panel-header goals-filter-header"><div><p class="eyebrow">SUA JORNADA</p><h2>Objetivos cadastrados</h2></div>
            <div class="tabs" role="group" aria-label="Filtrar objetivos"><button class="tab active" data-goal-filter="active">Em andamento</button><button class="tab" data-goal-filter="paused">Pausados</button><button class="tab" data-goal-filter="completed">Concluídos</button><button class="tab" data-goal-filter="archived">Arquivados</button><button class="tab" data-goal-filter="all">Todos</button></div>
          </div>
          <div class="goal-grid" id="goalList"><p class="muted">Carregando seus objetivos...</p></div>
        </section>
      <% } else if (page === 'intelligence') { %>
        <section class="page-heading intelligence-heading">
          <div><p class="eyebrow">ESPAÇO PARA O QUE IMPORTA</p><h1>Pattern Intelligence <span class="heading-sparkle">✳</span></h1><p class="muted">Sugestões para sua próxima semana, com base no que você já registrou.</p></div>
          <div class="intelligence-toolbar"><span class="muted small" id="intelligencePeriod"></span><button type="button" id="intelligenceGenerate" class="btn btn-primary">✧ Gerar sugestões</button></div>
        </section>
        <section class="intelligence-summary" id="intelligenceSummary"><p class="muted">Carregando...</p></section>
        <p class="intelligence-info" id="intelligenceStatus">Analisando seu planejamento...</p>
        <section class="panel intelligence-section"><div class="panel-header"><div><p class="eyebrow">SUAS POSSIBILIDADES</p><h2>Blocos de foco sugeridos</h2><p class="muted small">Os horários são sugestões. Nenhuma atividade será criada ou movida sem sua confirmação.</p></div></div><div class="intelligence-card-grid" id="intelligenceList"></div></section>
        <section class="panel intelligence-section"><div class="panel-header"><div><p class="eyebrow">JÁ PLANEJADO</p><h2>Blocos adicionados</h2></div><a class="subtle-link" href="/calendar">Ver calendário →</a></div><div id="intelligenceAccepted"></div></section>
        <dialog id="intelligenceConfirmDialog" class="modal"><div class="modal-title"><div><p class="eyebrow">CONFIRME ANTES DE AGENDAR</p><h2 id="intelligenceConfirmTitle">Reservar horário?</h2></div><button type="button" class="dialog-close" data-intelligence-close aria-label="Fechar">×</button></div><div class="form-stack"><p class="intelligence-confirm-date" id="intelligenceConfirmDate"></p><p class="muted small" id="intelligenceConfirmNote"></p><label>Bloco do calendário<select id="intelligenceCategory" required></select></label><p class="muted small">Confirmar criará um compromisso no calendário. A tarefa original não será concluída ou movida.</p><p class="error-message" id="intelligenceConfirmError" role="alert" hidden></p><div class="modal-actions"><button type="button" class="btn btn-soft" data-intelligence-close>Cancelar</button><button type="button" class="btn btn-primary" id="intelligenceConfirmSubmit">Confirmar horário</button></div></div></dialog>
      <% } else if (page === 'review') { %>
        <section class="page-heading review-heading"><div><p class="eyebrow">ENTENDA SUA SEMANA</p><h1>Retrospectiva semanal <span class="heading-sparkle">✳</span></h1><p class="muted">Registros reais para planejar com mais clareza.</p></div></section>
        <section class="panel review-topbar"><div><p class="eyebrow">SEU RESUMO</p><h2 id="reviewTitle">Carregando...</h2><p class="muted small" id="reviewStatus" role="status"></p></div><div class="review-nav"><button type="button" class="icon-button" id="reviewPrevious" aria-label="Semana anterior">←</button><button type="button" class="btn btn-soft" id="reviewCurrent">Esta semana</button><button type="button" class="icon-button" id="reviewNext" aria-label="Próxima semana">→</button></div></section>
        <section class="review-overview" id="reviewOverview"><p class="muted">Carregando indicadores...</p></section>
        <div class="review-columns"><section class="panel"><div class="panel-header"><div><p class="eyebrow">DADOS DA SEMANA</p><h2>O que seus registros mostram</h2></div></div><div id="reviewHighlights" class="review-highlights"></div><p id="reviewCaveat" class="muted small"></p></section><section class="panel"><div class="panel-header"><div><p class="eyebrow">EM EVOLUÇÃO</p><h2>Seus objetivos</h2></div><a class="subtle-link" href="/goals">Ver objetivos →</a></div><div id="reviewGoals" class="review-goals"></div></section></div>
        <section class="panel review-plan-panel"><div class="panel-header"><div><p class="eyebrow">OLHE PARA FRENTE</p><h2>Planejar próxima semana</h2><p class="muted small" id="reviewNextLabel">Veja tarefas pendentes e decida o que reorganizar.</p></div><button type="button" class="btn btn-primary" id="reviewPlanToggle" aria-expanded="false">Ver tarefas pendentes</button></div><div id="reviewPlan" hidden><p class="muted small">Nenhuma tarefa será movida automaticamente. Abra o calendário ou edite a tarefa para escolher outra data.</p><div class="review-pending" id="reviewPending"></div><div class="review-plan-actions"><a class="btn btn-soft" href="/tasks">Organizar tarefas →</a><a class="btn btn-soft" href="/intelligence">Planejamento assistido ✧</a><a class="btn btn-primary" href="/calendar">Abrir calendário →</a></div></div></section>
      <% } else if (page === 'settings') { %>
        <section class="page-heading"><div><p class="eyebrow">SEU ESPAÇO, SUA SEGURANÇA</p><h1>Minha conta <span class="heading-sparkle">✳</span></h1><p class="muted">Atualize seus dados e controle onde sua conta está conectada.</p></div></section>
        <p id="accountStatus" class="account-status muted small" role="status" aria-live="polite">Carregando sua conta...</p>
        <div class="account-grid">
          <section class="panel"><div class="panel-header"><div><p class="eyebrow">PERFIL</p><h2>Meus dados</h2></div></div>
            <form id="accountNameForm" class="form-stack"><label>Nome <input name="name" minlength="2" maxlength="80" required autocomplete="name" /></label><button class="btn btn-primary" type="submit">Salvar nome</button></form>
            <div class="account-email-info"><span class="eyebrow">E-MAIL ATUAL</span><strong id="accountEmail">Carregando...</strong><span id="accountVerification" class="muted small"></span><button type="button" class="btn btn-soft" id="resendVerification" hidden>Reenviar confirmação</button><p class="muted small" id="pendingEmail" hidden></p></div>
            <form id="accountEmailForm" class="form-stack"><h3>Alterar e-mail</h3><label>Novo endereço<input name="email" type="email" maxlength="254" required autocomplete="email" /></label><label>Senha atual<input name="currentPassword" type="password" required autocomplete="current-password" /></label><p class="muted small">O novo endereço só será ativado depois da confirmação por e-mail.</p><button class="btn btn-primary" type="submit">Solicitar alteração</button></form>
          </section>
          <section class="panel"><div class="panel-header"><div><p class="eyebrow">PROTEÇÃO</p><h2>Alterar senha</h2></div></div>
            <form id="accountPasswordForm" class="form-stack"><label>Senha atual<input name="currentPassword" type="password" required autocomplete="current-password" /></label><label>Nova senha<input name="newPassword" type="password" minlength="10" maxlength="72" required autocomplete="new-password" /></label><p class="muted small">Use uma senha exclusiva com pelo menos 10 caracteres. As outras sessões serão encerradas.</p><button class="btn btn-primary" type="submit">Alterar senha</button></form>
          </section>
        </div>
        <section class="panel account-sessions-panel"><div class="panel-header account-panel-title"><div><p class="eyebrow">DISPOSITIVOS CONECTADOS</p><h2>Sessões ativas</h2><p class="muted small">Encerre os acessos que não reconhecer.</p></div><button type="button" class="btn btn-soft" id="revokeOtherSessions">Sair de outros dispositivos</button></div><div id="accountSessions" class="account-session-list"><p class="muted small">Carregando sessões...</p></div></section>
      <% } else if (page === 'insights') { %>
        <section class="page-heading analytics-heading">
          <div><p class="eyebrow">DESCUBRA SEUS PADRÕES</p><h1>Pattern Analytics <span class="heading-sparkle">✳</span></h1><p class="muted">Seu planejamento, suas realizações e o tempo dedicado ao que importa.</p></div>
          <div class="analytics-period" role="group" aria-label="Período da análise">
            <button type="button" class="tab" data-analytics-days="7">7 dias</button>
            <button type="button" class="tab" data-analytics-days="14">14 dias</button>
            <button type="button" class="tab active" data-analytics-days="30">30 dias</button>
            <button type="button" class="tab" data-analytics-days="90">90 dias</button>
          </div>
        </section>
        <p class="analytics-status muted small" id="analyticsStatus" role="status" aria-live="polite">Carregando seus registros...</p>
        <section class="analytics-overview" id="analyticsOverview" aria-label="Indicadores do período"></section>
        <div class="analytics-main-grid">
          <section class="panel analytics-panel"><div class="panel-header"><div><p class="eyebrow">EVOLUÇÃO</p><h2>Seu tempo de foco</h2><p class="muted small">Tempo registrado por dia de término</p></div></div><div id="analyticsFocusChart" class="analytics-chart" role="img" aria-label="Gráfico de foco"></div></section>
          <section class="panel analytics-panel"><div class="panel-header"><div><p class="eyebrow">REALIZAÇÕES</p><h2>Tarefas concluídas</h2><p class="muted small">Conclusões registradas em cada dia</p></div></div><div id="analyticsTasksChart" class="analytics-chart" role="img" aria-label="Gráfico de tarefas"></div></section>
        </div>
        <div class="analytics-main-grid">
          <section class="panel analytics-panel"><div class="panel-header"><div><p class="eyebrow">CONSTÂNCIA</p><h2>Hábitos planejados e realizados</h2></div></div><div id="analyticsHabitProgress" class="analytics-habits"></div><div id="analyticsHabitHeatmap" class="analytics-heatmap" role="img" aria-label="Mapa de hábitos"></div></section>
          <section class="panel analytics-panel"><div class="panel-header"><div><p class="eyebrow">PLANEJAMENTO</p><h2>Tempo reservado por bloco</h2><p class="muted small">Compromissos agendados, não tempo efetivamente gasto</p></div></div><div id="analyticsCategories" class="analytics-categories"></div></section>
        </div>
        <div class="analytics-main-grid">
          <section class="panel analytics-panel"><div class="panel-header"><div><p class="eyebrow">CONCENTRAÇÃO</p><h2>Horário de início das sessões</h2><p class="muted small">Distribuição do tempo por hora de início</p></div></div><div id="analyticsHours" class="analytics-hours"></div></section>
          <section class="panel analytics-panel"><div class="panel-header"><div><p class="eyebrow">TEMPO DEDICADO</p><h2>Tarefas com mais foco</h2></div></div><div id="analyticsFocusTasks" class="analytics-focus-tasks"></div></section>
        </div>
        <section class="panel analytics-insight-panel"><div class="panel-header"><div><p class="eyebrow">LEITURA DOS DADOS</p><h2>O que seus registros mostram ✦</h2></div><span class="progress-sparkle" aria-hidden="true">✳</span></div><div id="analyticsInsights" class="analytics-insights"></div><p id="analyticsMethod" class="muted small"></p></section>
        <p class="privacy-note">Os indicadores representam dados registrados, não medem seu valor nem sua produtividade total. As estimativas históricas de hábitos e tarefas recorrentes usam a programação atual. Compromissos sobrepostos podem somar mais tempo que a duração do dia; eventos de dia inteiro contam como 24 horas agendadas.</p>
      <% } %>
    </main>
  </div>

  <dialog id="taskDialog" class="modal"><form id="taskForm" class="form-stack"><input type="hidden" name="id" /><div class="modal-title"><div><p class="eyebrow">PLANEJE COM CALMA</p><h2 id="taskDialogTitle">Nova tarefa</h2></div><button type="button" class="dialog-close" data-close="taskDialog" aria-label="Fechar">×</button></div><label>Nome da tarefa<input name="title" required maxlength="160" placeholder="Ex.: Revisar projeto Pattern" /></label><label>Detalhes (opcional)<textarea name="notes" rows="3" maxlength="2000" placeholder="Alguma observação importante?"></textarea></label><div class="modal-fields"><label>Data limite<input type="date" name="dueDate" /></label><label>Prioridade<select name="priority"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option></select></label></div>
    <label>Repetir tarefa<select name="repeat" class="repeat-select"><option value="none">Não repetir</option><option value="daily">Todos os dias</option><option value="weekly">Dias específicos da semana</option><option value="monthly">Todo mês</option></select></label>
    <fieldset class="repeat-weekdays" data-repeat-days="task" hidden><legend>Escolha os dias da semana</legend><div class="repeat-days"></div></fieldset>
    <label data-repeat-until="task" hidden>Repetir até (opcional)<input type="date" name="repeatUntil" /></label>
    <p class="muted small repeat-info" data-repeat-message="task" hidden>As alterações de uma tarefa recorrente afetam a série. As realizações de cada dia são registradas separadamente.</p>
    <p class="error-message" id="taskError" role="alert" hidden></p><div class="modal-actions"><button type="button" class="btn btn-soft" data-close="taskDialog">Cancelar</button><button type="submit" class="btn btn-primary">Salvar tarefa</button></div></form></dialog>
  <dialog id="eventDialog" class="modal"><form id="eventForm" class="form-stack">
    <input type="hidden" name="id" />
    <div class="modal-title"><div><p class="eyebrow">RESERVE UM TEMPO</p><h2 id="eventDialogTitle">Novo compromisso</h2></div><button type="button" class="dialog-close" data-close="eventDialog" aria-label="Fechar">×</button></div>
    <label>Compromisso<input name="title" required maxlength="160" placeholder="Ex.: Consulta, aula, reunião" /></label>
    <label>Quando acontece?<select name="timeMode" id="eventTimeMode" required><option value="exact">Horário definido</option><option value="all_day">Dia inteiro (sem horário de término)</option><option value="morning">Manhã · 06:00–12:00</option><option value="afternoon">Tarde · 12:00–18:00</option><option value="night">Noite · 18:00–00:00</option></select></label>
    <div class="modal-fields" id="eventExactFields"><label>Início<input name="startsAt" type="datetime-local" required /></label><label>Término<input name="endsAt" type="datetime-local" required /></label></div>
    <label id="eventDateField" hidden>Data do compromisso<input name="eventDate" type="date" /></label>
    <p class="muted small" id="eventTimeHelp" hidden></p>
    <label>Bloco do compromisso<select name="categoryId" required></select></label>
    <div data-event-recurrence><label>Repetir compromisso<select name="repeat" class="repeat-select"><option value="none">Não repetir</option><option value="daily">Todos os dias</option><option value="weekly">Dias específicos da semana</option><option value="monthly">Todo mês</option></select></label>
    <fieldset class="repeat-weekdays" data-repeat-days="event" hidden><legend>Escolha os dias da semana</legend><div class="repeat-days"></div></fieldset>
    <label data-repeat-until="event" hidden>Repetir até (opcional)<input type="date" name="repeatUntil" /></label>
    <p class="muted small repeat-info" data-repeat-message="event" hidden>A programação se aplica às próximas ocorrências de acordo com a escolha de edição.</p></div>
    <label id="eventScopeWrap" hidden>Aplicar alterações a<select id="eventEditScope" name="editScope"><option value="one">Somente esta ocorrência</option><option value="future">Esta e as próximas ocorrências</option><option value="all">Toda a série</option></select></label>
    <p class="muted small" id="eventScopeNote" hidden></p>
    <label>Observações (opcional)<textarea name="notes" rows="2" maxlength="2000" placeholder="Informações para lembrar depois..."></textarea></label>
    <p class="calendar-event-warning" id="eventConflictNotice" hidden></p><p class="error-message" id="eventError" role="alert" hidden></p>
    <div class="modal-actions event-modal-actions"><button type="button" class="btn btn-danger-outline" id="deleteEvent" hidden>Excluir</button><span class="modal-action-spacer"></span><button type="button" class="btn btn-soft" data-close="eventDialog">Cancelar</button><button type="submit" class="btn btn-primary" id="saveEvent">Salvar compromisso</button></div>
  </form></dialog>
  <dialog id="habitDialog" class="modal habit-modal"><form id="habitEditForm" class="form-stack">
    <input type="hidden" name="id" />
    <div class="modal-title"><div><p class="eyebrow">NO SEU RITMO</p><h2 id="habitDialogTitle">Novo hábito</h2></div><button type="button" class="dialog-close" data-close="habitDialog" aria-label="Fechar">×</button></div>
    <label>Nome do hábito<input name="name" required maxlength="100" placeholder="Ex.: Ler 20 minutos" /></label>
    <fieldset class="habit-days-field"><legend>Dias em que deseja praticar</legend><div class="day-picker" id="habitDaysPicker">
      <label><input type="checkbox" name="day" value="1" checked/><span>Seg</span></label>
      <label><input type="checkbox" name="day" value="2" checked/><span>Ter</span></label>
      <label><input type="checkbox" name="day" value="3" checked/><span>Qua</span></label>
      <label><input type="checkbox" name="day" value="4" checked/><span>Qui</span></label>
      <label><input type="checkbox" name="day" value="5" checked/><span>Sex</span></label>
      <label><input type="checkbox" name="day" value="6" checked/><span>Sáb</span></label>
      <label><input type="checkbox" name="day" value="0" checked/><span>Dom</span></label>
    </div></fieldset>
    <div class="modal-fields"><label>Meta semanal<input type="number" name="goalPerWeek" min="1" max="7" value="7" required /></label><label>Horário sugerido (opcional)<input type="time" name="preferredTime" /></label></div>
    <label>Rotina (opcional)<select name="routineId"><option value="">Sem rotina</option></select></label>
    <p class="muted small">A meta não pode ser maior que a quantidade de dias escolhidos.</p>
    <p class="error-message" id="habitError" role="alert" hidden></p>
    <div class="modal-actions"><button type="button" class="btn btn-soft" data-close="habitDialog">Cancelar</button><button type="submit" class="btn btn-primary">Salvar hábito</button></div>
  </form></dialog>
  <dialog id="routineDialog" class="modal"><form id="routineForm" class="form-stack">
    <input type="hidden" name="id" />
    <div class="modal-title"><div><p class="eyebrow">ORGANIZE SEUS MOMENTOS</p><h2 id="routineDialogTitle">Nova rotina</h2></div><button type="button" class="dialog-close" data-close="routineDialog" aria-label="Fechar">×</button></div>
    <label>Nome da rotina<input name="name" required maxlength="100" placeholder="Ex.: Minha manhã tranquila" /></label>
    <label>Quando acontece?<select name="period"><option value="morning">Manhã</option><option value="evening">Noite</option><option value="flexible">Qualquer horário</option></select></label>
    <label>Descrição (opcional)<textarea name="description" rows="2" maxlength="240" placeholder="Qual a intenção desta rotina?"></textarea></label>
    <p class="error-message" id="routineError" role="alert" hidden></p>
    <div class="modal-actions"><button type="button" class="btn btn-soft" data-close="routineDialog">Cancelar</button><button type="submit" class="btn btn-primary">Salvar rotina</button></div>
  </form></dialog>
  <dialog id="categoryDialog" class="modal category-modal">
    <div class="modal-title"><div><p class="eyebrow">DEIXE DO SEU JEITO</p><h2>Meus blocos</h2></div><button type="button" class="dialog-close" data-close="categoryDialog" aria-label="Fechar">×</button></div>
    <p class="muted small">Crie blocos como Amigos, Namoro, Faculdade ou Viagens e escolha a cor de cada um.</p>
    <div id="categoryList" class="category-list"></div>
    <form id="categoryForm" class="form-stack category-edit-form">
      <input type="hidden" name="id" />
      <div class="modal-fields"><label>Nome do bloco<input type="text" name="name" maxlength="40" placeholder="Ex.: Amigos" required /></label><label>Cor do bloco<input type="color" name="color" value="#9675d5" required /></label></div>
      <p class="error-message" id="categoryError" role="alert" hidden></p>
      <div class="modal-actions"><button class="btn btn-soft" type="button" id="resetCategory">Novo bloco</button><button class="btn btn-primary" type="submit">Salvar bloco</button></div>
    </form>
  </dialog>
  <dialog id="confirmDialog" class="modal confirmation-modal" aria-labelledby="confirmTitle">
    <div class="confirm-mark" aria-hidden="true">!</div>
    <h2 id="confirmTitle">Excluir item?</h2><p id="confirmMessage" class="muted"></p>
    <fieldset id="deleteScope" class="delete-scope" hidden><legend>O que você deseja excluir?</legend><label><input type="radio" name="deleteScope" value="one" checked /> Somente esta ocorrência</label><label><input type="radio" name="deleteScope" value="series" /> Toda a série</label></fieldset>
    <p class="error-message" id="confirmError" role="alert" hidden></p>
    <div class="modal-actions"><button type="button" class="btn btn-soft" data-close="confirmDialog">Cancelar</button><button type="button" class="btn btn-danger" id="confirmDelete">Sim, excluir</button></div>
  </dialog>
  <dialog id="goalDialog" class="modal goal-modal"><form id="goalForm" class="form-stack"><input type="hidden" name="id" />
    <div class="modal-title"><div><p class="eyebrow">DÊ UM PASSO DE CADA VEZ</p><h2 id="goalDialogTitle">Novo objetivo</h2></div><button type="button" class="dialog-close" data-goal-close="goalDialog" aria-label="Fechar">×</button></div>
    <label>Nome do objetivo<input name="title" maxlength="140" required placeholder="Ex.: Concluir minha formação em Python" /></label>
    <label>Descrição (opcional)<textarea name="description" rows="3" maxlength="1200" placeholder="O que você deseja conquistar?"></textarea></label>
    <div class="modal-fields"><label>Categoria<input name="category" maxlength="40" value="Pessoal" required placeholder="Ex.: Estudos" /></label><label>Data limite (opcional)<input type="date" name="dueDate" /></label></div>
    <div class="modal-fields"><label>Prioridade<select name="priority"><option value="low">Baixa</option><option value="medium" selected>Média</option><option value="high">Alta</option></select></label><label>Situação<select name="status"><option value="active">Em andamento</option><option value="paused">Pausado</option><option value="completed">Concluído</option><option value="archived">Arquivado</option></select></label></div>
    <p class="error-message" id="goalError" role="alert" hidden></p><div class="modal-actions"><button type="button" class="btn btn-soft" data-goal-close="goalDialog">Cancelar</button><button class="btn btn-primary" type="submit">Salvar objetivo</button></div>
  </form></dialog>
  <dialog id="logoutConfirmDialog" class="modal confirmation-modal" aria-labelledby="logoutConfirmTitle" aria-describedby="logoutConfirmMessage">
    <div class="confirm-mark logout-confirm-mark" aria-hidden="true">↗</div>
    <h2 id="logoutConfirmTitle">Sair do Pattern?</h2>
    <p id="logoutConfirmMessage" class="muted">Deseja mesmo sair da sua conta? Você poderá entrar novamente quando quiser.</p>
    <p class="error-message" id="logoutError" role="alert" hidden></p>
    <div class="modal-actions"><button type="button" class="btn btn-soft" data-close="logoutConfirmDialog">Continuar conectada</button><button type="button" class="btn btn-primary" id="logoutConfirm">Sim, sair</button></div>
  </dialog>
  <dialog id="goalConfirm" class="modal confirmation-modal" aria-labelledby="goalConfirmTitle"><div class="confirm-mark" aria-hidden="true">!</div><h2 id="goalConfirmTitle">Excluir objetivo?</h2><p class="muted" id="goalConfirmText"></p><p class="error-message" id="goalConfirmError" hidden role="alert"></p><div class="modal-actions"><button type="button" class="btn btn-soft" data-goal-close="goalConfirm">Cancelar</button><button type="button" class="btn btn-danger" id="goalConfirmSubmit">Sim, excluir</button></div></dialog>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
</body>
</html>
